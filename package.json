{
  "name": "node-miio",
  "version": "0.3.0-beta.2",
  "license": "MIT",
  "description": "Control Mi Home devices, such as Mi Robot Vacuums, Mi Air Purifiers, Mi Smart Home Gateway (Aqara) and more",
  "author": "https://github.com/afharo",
  "homepage": "https://github.com/afharo/miio/blob/main/README.md",
  "main": "dist/lib/index.js",
  "keywords": [
    "xiaomi",
    "mi",
    "miio",
    "aqara",
    "yeelight",
    "mijia"
  ],
  "bin": {
    "node-miio": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc",
    "snapshot": "node scripts/update-spec-snapshot.mjs",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean",
    "preversion": "npm run lint && npm run build && npm test",
    "version": "git add .",
    "postversion": "git push && git push --tags",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch -verbose",
    "test:coverage": "jest --verbose --coverage",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "abstract-things": "^0.9.0",
    "chalk": "^4.1.2",
    "debug": "^4.4.3",
    "deep-equal": "^2.2.3",
    "node-persist": "^4.0.4",
    "tinkerhub-discovery": "^0.6.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "9.39.5",
    "@types/deep-equal": "^1.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/node-persist": "^3.1.8",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jsdoc": "54.7.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.2",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
