{
  "name": "node-miio",
  "version": "0.16.0",
  "license": "MIT",
  "description": "Control Mi Home devices, such as Mi Robot Vacuums, Mi Air Purifiers, Mi Smart Home Gateway (Aqara) and more",
  "author": "https://github.com/afharo",
  "homepage": "https://github.com/afharo/node-miio/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afharo/node-miio.git"
  },
  "bugs": {
    "url": "https://github.com/afharo/node-miio/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/afharo"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/afharo"
    }
  ],
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "keywords": [
    "xiaomi",
    "miio",
    "mi-home",
    "mijia",
    "roborock",
    "vacuum",
    "robot-vacuum",
    "aqara",
    "yeelight",
    "air-purifier",
    "smart-home",
    "iot"
  ],
  "bin": {
    "node-miio": "dist/cli/index.js"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc",
    "test:types": "node scripts/check-types.mjs",
    "snapshot": "node scripts/update-spec-snapshot.mjs",
    "snapshot:statuses": "node scripts/update-status-fixture.mjs",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean",
    "preversion": "npm run lint && npm run build && npm run test:types && npm test",
    "version": "git add .",
    "postversion": "git push && git push --tags",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error && prettier --check \"**/*.{ts,js,cjs,mjs,mts}\"",
    "lint:fix": "oxlint --fix && prettier --write \"**/*.{ts,js,cjs,mjs,mts}\""
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@types/debug": "^4.1.13",
    "color-string": "^1.9.1",
    "debug": "^4.4.3",
    "mqtt": "^5.16.1",
    "uqr": "^0.1.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/color-string": "^1.5.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "1.94.0",
    "prettier": "3.6.2",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
