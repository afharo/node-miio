{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
    "sourceMap": true,
    "declaration": true,
    "stripInternal": true,
    "rootDir": "src",
    "outDir": "dist",
    "noImplicitAny": false,

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["node_modules/@types"],
  },
  "include": ["src"],
}
